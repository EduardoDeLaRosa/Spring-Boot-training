      "name": "01 - Crear envío",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/shipments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shipments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"trackingCode\": \"PKG20260001\",\n  \"recipientName\": \"Lucía Gómez\",\n  \"destinationCity\": \"Sevilla\",\n  \"parcelType\": \"SMALL_PACKAGE\",\n  \"specialInstructions\": \"Llamar antes de entregar\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 - Listar envíos",
      "request": {
        "method": "GET",
