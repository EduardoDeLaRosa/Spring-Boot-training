      }
    },
    {
      "name": "09 - Último mantenimiento",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/service-records/vehicle/{{vehiclePlate}}/latest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      }
    },
    {
      "name": "10 - Eliminar",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/service-records/{{recordId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      }
    }
  ]
