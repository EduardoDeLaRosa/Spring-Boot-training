{
  "info": {
    "name": "Project 3 - Vehicle Service History",
    "description": "Colección base para probar el Proyecto 3 del Módulo 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "recordId",
      "value": "1"
    },
    {
      "key": "vehiclePlate",
      "value": "1234ABC"
    }
  ],
